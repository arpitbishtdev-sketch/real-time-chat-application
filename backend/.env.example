# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local dev example)
MONGODB_URI=mongodb://127.0.0.1:27017/chat-app-dev

# Frontend origin allowed by CORS (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# Secrets used to sign JWTs — generate long random strings, at least 32 characters.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-at-least-32-chars
